MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
PORT=4000
CORS_ORIGIN=http://localhost:5180
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Cho backend tự serve luôn frontend đã build tĩnh (dùng khi deploy backend+frontend
# chung 1 server/port trên máy thật — xem app.js). Để trống/false khi dev local, vì
# lúc đó frontend chạy Vite riêng ở cổng 5180, không cần backend serve.
FRONTEND_STATIC_ENABLED=false
FRONTEND_DIST_PATH=

# Tài khoản cổng tra cứu BHXH (egw.baohiemxahoi.gov.vn) — dùng để check thẻ BHYT
# (họ tên/ngày sinh) cho ML011/ML019, xem services/bhxhEgwService.js. Không commit
# giá trị thật vào git — chỉ điền trong file .env cục bộ/server.
BHXH_EGW_USERNAME=
BHXH_EGW_PASSWORD=
# Họ tên/CCCD người thực hiện tra cứu (cán bộ) — cố định theo tài khoản cổng, KHÔNG
# phải thông tin bệnh nhân (maThe/ngaySinh/hoTen của bệnh nhân lấy từ hồ sơ XML).
BHXH_EGW_HOTENCB=
BHXH_EGW_CCCDCB=
# URL lấy token và URL check thẻ của cổng BHXH — không hard-code trong source, xem
# services/bhxhEgwService.js. Điền URL thật do BHXH cấp cho đơn vị.
BHXH_EGW_TOKEN_URL=
BHXH_EGW_CHECK_URL=
