MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
PORT=4000
CORS_ORIGIN=http://localhost:5180
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Tài khoản cổng tra cứu BHXH (egw.baohiemxahoi.gov.vn) — dùng để check thẻ BHYT
# (họ tên/ngày sinh) cho ML011/ML019, xem services/bhxhEgwService.js. Không commit
# giá trị thật vào git — chỉ điền trong file .env cục bộ/server.
BHXH_EGW_USERNAME=
BHXH_EGW_PASSWORD=
